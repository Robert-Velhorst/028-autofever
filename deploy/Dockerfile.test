# Test-only Linux image. No production secrets, ports, volumes or mail provider.
FROM python:3.15.0-slim-bookworm@sha256:122756f3fe72c4f5d3d71897888204ee85774bc79de952555b8a474e1d0a5d53
WORKDIR /app
COPY backend/requirements.lock /app/backend/requirements.lock
RUN python -m pip install --no-cache-dir --require-hashes -r backend/requirements.lock
COPY backend/*.py /app/backend/
COPY backend/smtp.example.json /app/backend/
COPY backend/tests/*.py /app/backend/tests/
COPY deploy/__init__.py deploy/host_preflight.py deploy/028-autofever-worker.service /app/deploy/
COPY backend/static/*.js backend/static/*.css backend/static/*.html backend/static/*.svg /app/backend/static/
COPY illness-preview/index.html /app/illness-preview/index.html
COPY illness-preview/i18n.js /app/illness-preview/i18n.js
RUN useradd --uid 1028 --create-home autofever-test
USER 1028:1028
ENV PYTHONDONTWRITEBYTECODE=1
CMD ["python", "-W", "error::ResourceWarning", "-m", "unittest", "discover", "-s", "backend/tests", "-q"]
